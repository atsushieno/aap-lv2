@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
<urn:aap:test:state> a lv2:Plugin ;
    doap:name "State fixture" ; lv2:binary <state_fixture.so> ;
    lv2:extensionData state:interface ;
    lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "gain" ;
               lv2:name "Gain" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 2.0 ],
             [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "audio" ; lv2:name "Audio" ] .
